# Ahdapa reverse proxy — managed by FreeIPA installer.
# This file may be overwritten on upgrades.
#
# The placeholder hostname after "|" is mod_proxy's worker-pool key, not a
# real destination -- the actual socket comes from the unix: prefix. It must
# be unique across every Unix-socket-backed ProxyPass FreeIPA configures
# (compare ipa-akamu-proxy.conf.template): mod_proxy has a long-standing
# worker-sharing bug where two UDS workers with the same logical URL can
# have their pooled connections cross-contaminated, silently routing a
# request to the wrong backend socket.
# Ahdapa's session cookie (Set-Cookie) embeds the user's group
# memberships in an AES-256-GCM sealed, base64url-encoded blob, so it
# grows with the user's group count. Raise both per-field header
# limits from the 8 KiB defaults:
#
#   LimitRequestFieldSize (server level, below): the same oversized
#   cookie comes back in the Cookie header of every subsequent request
#   to /idp/; without this, Apache rejects those requests (AH10102).
#
#   ResponseFieldSize (mod_proxy worker parameter on the ProxyPass
#   inside the Location below, not a standalone directive): the
#   upstream Set-Cookie from the login response; without it, Apache
#   rejects the login response (AH10124/AH01106, logged with a
#   misleading "(28)No space left on device" errno string).
#
# 32768 bytes supports roughly 700-900 short group names.
LimitRequestFieldSize 32768

RedirectMatch permanent ^/idp$$ /idp/

<Location "/idp/">
    AuthType None
    Require all granted

    # ProxyPass/ProxyPassReverse/ProxyPassReverseCookiePath must live inside
    # this Location, not at top level: mod_proxy's Set-Cookie Path rewriting
    # is a global, load-order-dependent match on the *internal* path alone
    # ("/" here) -- it is not scoped to which ProxyPass/backend actually
    # served the response. Since ahdapa's and akamu's proxy confs both
    # rewrite from "/", declaring these at top level lets whichever conf
    # file loads first (alphabetically) silently steal the other's cookie
    # rewrite, breaking session cookies for one of the two services.
    # Verified empirically against httpd 2.4.68/mod_proxy.
    # ResponseFieldSize=... is a mod_proxy ProxyPass worker parameter
    # (present in 2.4 builds since the 2018 PR62199 backport): it
    # raises the per-field limit on upstream response headers, where
    # Ahdapa's login Set-Cookie can exceed the 8192-byte default.
    ProxyPass        unix:$AHDAPA_SOCKET|http://ahdapa-local/  nocanon ResponseFieldSize=32768
    ProxyPassReverse http://ahdapa-local/
    ProxyPassReverseCookiePath / /idp/
    ProxyPreserveHost On

    SSLOptions +StdEnvVars +ExportCertData +StrictRequire
    SSLVerifyClient none

    RequestHeader set X-Forwarded-Proto "https"

    Header always set    X-Content-Type-Options "nosniff"
    Header always append X-Frame-Options "DENY"
    Header always append Content-Security-Policy "frame-ancestors 'none'"
</Location>

RewriteCond %{SERVER_PORT} !^443$$
RewriteRule ^/idp/(.*)     https://%{HTTP_HOST}/idp/$$1 [L,R=307,NC]
