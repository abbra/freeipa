# kuipa (IPA Key Unwrap Service) schema
#
# Names, OIDs and syntaxes match what the daemon reads and writes
# (kuipa crates/kuipad/src/directory.rs) and kuipa docs/DESIGN-schema.md.
# Attribute arc: 2.16.840.1.113730.3.8.32.*
# ObjectClass arc: 2.16.840.1.113730.3.8.33.*
dn: cn=schema
attributeTypes: ( 2.16.840.1.113730.3.8.32.1 NAME 'ipaKUEscrowBinding' DESC 'Registered escrow binding hashes of sealed keytabs, H(ct)' EQUALITY octetStringMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.2 NAME 'ipaKUEscrowFileBinding' DESC 'Registered escrow binding hashes of sealed files, H(ct)' EQUALITY octetStringMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.3 NAME 'ipaKUStaged' DESC 'JSON record of a staged enrollment (not_after, recipient)' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.4 NAME 'ipaKUVoucherSpent' DESC 'Hex salt of the voucher spent to create this host' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.5 NAME 'ipaKUSealOwner' DESC 'Principal name of the seal owner' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.6 NAME 'ipaKUSealName' DESC 'Owner-assigned seal name, unique per owner' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.7 NAME 'ipaKUSealPolicy' DESC 'Seal policy, JSON' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.8 NAME 'ipaKUSealDevice' DESC 'Registered seal device, JSON, one value per device' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.9 NAME 'ipaKUSealState' DESC 'Seal state: enabled or revoked' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.10 NAME 'ipaKUSealUnlocks' DESC 'Offline unlock count of one server: "<server fqdn> <count>", one value per server' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.11 NAME 'ipaKUSealSessionKey' DESC 'Sealed offline-session key, JSON, one value per epoch' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.12 NAME 'ipaKUSealBinding' DESC 'Registered binding of a seal file, hex H(ct)' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.13 NAME 'ipaKUSealManager' DESC 'Seal manager, kind:name (user, group, host, service principal)' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.14 NAME 'ipaKUSealMember' DESC 'Seal member, kind:name (user, group, host, service principal)' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.15 NAME 'ipaKUSealDepositor' DESC 'Seal depositor, kind:name, may deposit without opening' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.16 NAME 'ipaKUSealApprover' DESC 'Seal release approver, kind:name, drawn from the policy' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.17 NAME 'ipaKUDepositData' DESC 'Seal deposit, JSON, including the sealed IPUF payload' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.18 NAME 'ipaKUReleaseRequest' DESC 'Seal release request, JSON' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.19 NAME 'ipaKUReleaseApproval' DESC 'Release approval: "<approver kind:name> <unix time>", add-only' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.20 NAME 'ipaKUReleaseDenied' DESC 'Release denial: "<approver kind:name> <unix time>"' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.21 NAME 'ipaKUReleaseUses' DESC 'Release use count of one server: "<server fqdn> <count>", one value per server' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.22 NAME 'ipaKUDeviceEscrow' DESC 'Device-key recovery escrow, JSON, one value per device' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.23 NAME 'ipaKURecovery' DESC 'Realm device-key recovery settings, JSON' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.24 NAME 'ipaKULease' DESC 'End of a leased host lease, seconds since epoch' EQUALITY integerMatch ORDERING integerOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.25 NAME 'ipaKUVouchers' DESC 'Realm voucher settings, JSON (max_lease)' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.26 NAME 'ipaKUServerEscrowKey' DESC 'Current seal escrow key of a server: "<KEM id> <base64url key>"' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.27 NAME 'ipaKUSealLimits' DESC 'Realm seal limits, JSON' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.28 NAME 'ipaKUSignPolicy' DESC 'Realm signing policy, JSON' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.29 NAME 'ipaKUTrustInvitation' DESC 'Trust invitation: "<hex secret hash> <not after unix seconds>", consumed by deleting the exact value' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.30 NAME 'ipaKUTrustedRealm' DESC 'Trusted partner realm, JSON, one value per realm' EQUALITY caseExactMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.31 NAME 'ipaKUVoucherHost' DESC 'FQDN of the host a spent voucher salt was spent for' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
attributeTypes: ( 2.16.840.1.113730.3.8.32.32 NAME 'ipaKUVoucherRedeemer' DESC 'FQDN of the IPA server that took the join a voucher salt was spent for' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.1 NAME 'ipaKUSeal' DESC 'kuipa seal with per-device escrow' SUP top STRUCTURAL MUST ( cn $ ipaKUSealOwner $ ipaKUSealName ) MAY ( ipaKUSealPolicy $ ipaKUSealManager $ ipaKUSealMember $ ipaKUSealDepositor $ ipaKUSealApprover $ ipaKUSealDevice $ ipaKUSealState $ ipaKUSealUnlocks $ ipaKUSealSessionKey $ ipaKUSealBinding $ description ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.2 NAME 'ipaKUDeposit' DESC 'kuipa seal deposit' SUP top STRUCTURAL MUST ( cn $ ipaKUDepositData ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.3 NAME 'ipaKURelease' DESC 'kuipa seal release request' SUP top STRUCTURAL MUST ( cn $ ipaKUReleaseRequest ) MAY ( ipaKUReleaseApproval $ ipaKUReleaseDenied $ ipaKUReleaseUses ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.4 NAME 'ipaKUPrincipalEscrow' DESC 'kuipa escrow bindings on a host, service or user entry' SUP top AUXILIARY MAY ( ipaKUEscrowBinding $ ipaKUEscrowFileBinding $ ipaKUStaged $ ipaKUVoucherSpent $ ipaKULease $ ipaKUDeviceEscrow ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.5 NAME 'ipaKUSealContainer' DESC 'kuipa seal container' SUP top STRUCTURAL MUST ( cn ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.6 NAME 'ipaKURealmConfig' DESC 'kuipa realm-wide configuration entry' SUP top AUXILIARY MAY ( ipaKURecovery $ ipaKUVouchers $ ipaKUSealLimits $ ipaKUSignPolicy ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.7 NAME 'ipaKUTrust' DESC 'kuipa trust invitations and partners' SUP top AUXILIARY MAY ( ipaKUTrustInvitation $ ipaKUTrustedRealm ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.8 NAME 'ipaKUMasterEscrow' DESC 'kuipa server escrow key on a master entry' SUP top AUXILIARY MAY ( ipaKUServerEscrowKey ) X-ORIGIN 'IPA v4.14' )
objectClasses: ( 2.16.840.1.113730.3.8.33.9 NAME 'ipaKUVoucherSpentRecord' DESC 'kuipa spent voucher salt, kept until the voucher expires' SUP top STRUCTURAL MUST ( cn ) MAY ( ipaKUVoucherSpent $ ipaKUVoucherHost $ ipaKUVoucherRedeemer $ ipaKULease ) X-ORIGIN 'IPA v4.14' )
