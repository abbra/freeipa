#!/usr/bin/python3

import argparse

from ipaserver.install import kuipadinstance

OID_AES128_CBC = "2.16.840.1.101.3.4.1.2"


def main():
    parser = argparse.ArgumentParser("ipa-pki-retrieve-key")
    parser.add_argument("keyname", type=str)
    # shortcut: servername is accepted for ExternalProcessKeyRetriever argv
    # compatibility and ignored; kuipa selects the enrolled server itself.
    parser.add_argument("servername", type=str)

    args = parser.parse_args()

    # The output is already in the format Dogtag's
    # ExternalProcessKeyRetriever expects; pass it through unchanged.
    print(kuipadinstance.fetch_key(
        "ca_wrapped/{}".format(args.keyname), alg=OID_AES128_CBC))


if __name__ == '__main__':
    main()
