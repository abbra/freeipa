summary: Run a FreeIPA env queue job on a TF guest
discover:
    how: fmf
    test: "^/ci/tmt/tests/"
prepare:
    how: install
    package:
      - podman
      - curl
      - git
      - rpm
      - rpm-build
      - make
      - autoconf
      - automake
      - libtool
      - pkgconf
      - pkgconfig
      - gettext
      - gettext-devel
      - gcc
      - diffutils
      - file
      - findutils
      - xz
      - tar
      - openldap-devel
      - krb5-devel
      - krb5-server
      - libcurl-devel
      - jansson-devel
      - popt-devel
      - gnupg2
      - nspr-devel
      - openssl-devel
      - libini_config-devel
      - cyrus-sasl-devel
      - python3-devel
      - python3-setuptools
      - python3-argcomplete
      - systemd
      - httpd
      - xmlrpc-c-devel
      - 389-ds-base-devel
      - samba-devel
      - libtalloc-devel
      - libtevent-devel
      - libuuid-devel
      - libpwquality-devel
      - libsss_idmap-devel
      - libsss_certmap-devel
      - libsss_nss_idmap-devel
      - nodejs
      - npm
      - python3-rjsmin
      - libverto-devel
      - libunistring-devel
      - python3-lesscpy
      - cracklib-dicts
      - python3-cffi
      - python3-dns
      - python3-ldap
      - python3-libsss_nss_idmap
      - python3-netaddr
      - python3-pyasn1
      - python3-pyasn1-modules
      - python3-six
      - python3-psutil
      - libcmocka-devel
      - selinux-policy-devel
execute:
    how: tmt
